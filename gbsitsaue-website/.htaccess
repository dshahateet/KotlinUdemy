Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Block direct access to internal files
<FilesMatch "^(config\.php|database\.sql|README\.md)$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/(includes|partials|lang)/

# Custom 404 page
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS and the bare domain (gbsitsaue.com)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://gbsitsaue.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
